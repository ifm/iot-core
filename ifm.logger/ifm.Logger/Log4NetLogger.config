<?xml version="1.0" encoding="utf-8" ?>

<log4net>
  <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="${ProgramData}\ifm\log.txt" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="10" />
    <maximumFileSize value="10MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %message%newline" />
    </layout>
  </appender>
  <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %message%newline" />
    </layout>
  </appender>
  <appender name="UdpAppender" type="log4net.Appender.UdpAppender">
    <RemoteAddress value="127.0.0.1" />
    <RemotePort value="7071" />
    <Encoding value="utf-8" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %message%newline" />
    </layout>
  </appender>
  <appender name="RaiseEventAppender" type="ifm.Logger.RaiseEventAppender,ifm.Logger">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %message%newline" />
    </layout>
  </appender>
  <appender name="HttpAppender" type="ifm.Logger.HttpAppender, ifm.Logger">
    <Url value="http://your-log-endpoint/api/logs" />
    <ContentType value="text/plain" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %message%newline" />
    </layout>
  </appender>
  <!-- Custom UDP appender supports host name -->
  <appender name="CustomUdpAppender" type="ifm.Logger.UdpAppender, ifm.Logger">
    <RemoteHost value="127.0.0.1" />
    <RemotePort value="7071" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %message%newline" />
    </layout>
  </appender>
  <logger name="MyLogger">
    <level value="INFO" />
    <appender-ref ref="RollingFileAppender" />
    <appender-ref ref="ConsoleAppender" />
    <!-->appender-ref ref="RaiseEventAppender" /-->
  </logger>
</log4net>
