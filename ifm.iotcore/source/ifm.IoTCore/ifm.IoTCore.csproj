<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<AssemblyVersion>8.0.0</AssemblyVersion>
		<Version>8.0.0</Version>
		<Company>ifm ecomatic gmbh</Company>
		<Product>ifm IoT-Core</Product>
		<Description>The package contains the IoT-Core base classes.</Description>
		<Copyright>Copyright © ifm ecomatic gmbh. All rights reserved.</Copyright>
		<Authors>ESI Middleware</Authors>
		<LangVersion>latest</LangVersion>
		<IsPackable>true</IsPackable>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<DebugType>embedded</DebugType>
		<EmbedAllSources>true</EmbedAllSources>
		<!--<GenerateDocumentationFile>true</GenerateDocumentationFile>-->
	</PropertyGroup>
	<PropertyGroup Condition="'$(CI_BUILD)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\..\LICENSE.txt" Pack="true" PackagePath="." />
		<None Include="..\..\NOTICE.md" Pack="true" PackagePath="." />
		<None Include="..\..\Release Notes.txt" Pack="True" PackagePath="." />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\..\ifm.common\ifm.Common\ifm.Common.csproj" />
		<ProjectReference Include="..\..\..\ifm.datastore\ifm.DataStore.Contracts\ifm.DataStore.Contracts.csproj" />
		<ProjectReference Include="..\..\..\ifm.logger\ifm.Logger.Contracts\ifm.Logger.Contracts.csproj" />
		<ProjectReference Include="..\ifm.IoTCore.Common\ifm.IoTCore.Common.csproj" />
		<ProjectReference Include="..\ifm.IoTCore.Contracts\ifm.IoTCore.Contracts.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Compile Update="Resources\Resource1.Designer.cs">
			<DependentUpon>Resource1.resx</DependentUpon>
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Update="Resources\Resource1.resx">
			<LastGenOutput>Resource1.Designer.cs</LastGenOutput>
			<Generator>PublicResXFileCodeGenerator</Generator>
		</EmbeddedResource>
	</ItemGroup>
</Project>